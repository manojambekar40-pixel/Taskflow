# --- Database ---
# Leave unset for local SQLite. Set to a PostgreSQL URL in production (Render).
DATABASE_URL=

# --- Groq / AI Quick Add ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
USE_REAL_LLM=false

# --- CORS ---
# Deployed frontend origin, e.g. https://taskflow.onrender.com
FRONTEND_URL=

# --- Server ---
PORT=8000
